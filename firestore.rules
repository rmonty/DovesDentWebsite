rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /site/content {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email in [
          'rmonty98@gmail.com',
          'dovehailrepair@gmail.com'
        ];
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
